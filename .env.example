# Copie para .env e preencha os valores marcados com "CHANGE-ME".
# Nunca versione o .env real - só este exemplo.
# Segredos: SECRET_KEY, *_PASSWORD, *_API_KEY, FIELD_ENCRYPTION_KEY.

REQUIREMENTS_PATH=requirements.txt

# Dev roda uvicorn direto (auto-reload). Em produção:
#   gunicorn -c config/gunicorn.conf.py config.asgi:application
BACKEND_COMMAND=uvicorn config.asgi:application --host 0.0.0.0 --port 9000 --reload
BACKEND_PORT=9000
BACKEND_CONTAINER_PORT=9000

# DJANGO VARS
DJANGO_SETTINGS_MODULE=config.settings
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
SECRET_KEY=CHANGE-ME  # gere: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DEBUG=True
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# SUPERUSER SETTINGS (criado no boot se DJANGO_ADD_SUPERUSER=True)
DJANGO_ADD_SUPERUSER=True
DJANGO_SUPERUSER_FIRST_NAME=Admin
DJANGO_SUPERUSER_LAST_NAME=Local
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=CHANGE-ME
DJANGO_SUPERUSER_CPF=00000000000

# LOGGING (Prod: INFO | json)
LOG_LEVEL=DEBUG
LOG_FORMAT=verbose

# COLLECT STATIC SETTINGS
DJANGO_COLLECTSTATIC=False
DJANGO_LOADFIXTURES=False
DJANGO_MIGRATE=True

# DATABASE VARS (DB_NAME/DB_USER/DB_PASSWORD devem casar com .db.env)
DATABASE=postgres
DB_ENGINE=django.db.backends.postgresql
DB_NAME=medessence_db
DB_USER=medessence_user
DB_PASSWORD=CHANGE-ME
DB_HOST=medessence_db
DB_PORT=5432
DB_CONTAINER_PORT=5433
ENABLE_DB_BACKUP=false

MEDIA_ROOT=./media/
STATIC_ROOT=./static/

# REDIS VARS (REDIS_PASSWORD deve casar com as URLs do Celery abaixo)
REDIS_HOST=medessence_redis
REDIS_PASSWORD=CHANGE-ME
REDIS_PORT=6379
REDIS_CONTAINER_PORT=6380

# CELERY VARS (troque a senha nas URLs pela mesma do REDIS_PASSWORD)
CELERY_BROKER_URL=redis://:CHANGE-ME@medessence_redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE-ME@medessence_redis:6379/0
CELERY_WORKER_COMMAND=celery -A config worker -l info
CELERY_BEAT_COMMAND=celery -A config beat -l info
CELERY_WORKER_CONCURRENCY=1
CELERY_RUN_INTERVAL_MINUTES=1

# ASAAS VARS (pagamentos)
ASAAS_API_KEY=CHANGE-ME
ASAAS_API_URL=https://api.asaas.com/

# MAILGUN VARS (e-mail)
MAILGUN_API_KEY=CHANGE-ME
MAILGUN_API_URL=https://api.mailgun.net/v3
MAILGUN_SENDER_DOMAIN=mail.example.com
DEFAULT_FROM_EMAIL=noreply@mail.example.com
EMAIL_BACKEND=anymail.backends.mailgun.EmailBackend
SERVER_EMAIL=noreply@mail.example.com
DEFAULT_FROM_PASS=CHANGE-ME

# FIELD ENCRYPTION (EncryptedJSONField - credenciais de integração)
# gere: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=CHANGE-ME

# VSAUDE VARS (base URL padrão; a API key é por clínica, no admin)
VSAUDE_API_URL=https://public-api.vsaude.com.br/api/services/app

# WHATSAPP — Meta Cloud API (§7). SÓ o que é do APP da plataforma mora aqui.
# O que é do NÚMERO (access_token, phone_number_id, waba_id) fica cifrado no
# Channel de cada clínica, via `manage.py wa_channel` — nunca neste arquivo.
#
# Vazios = o webhook recusa tudo (fail closed). Preencher na calibração.
#
# APP_SECRET: painel do app → Configurações → Básico → Chave Secreta.
#   A Meta assina cada webhook com ela (X-Hub-Signature-256).
# VERIFY_TOKEN: VOCÊ INVENTA. Não existe no painel — é uma senha combinada
#   entre este arquivo e o campo "Verificar token" da configuração do webhook.
#   Precisa ser idêntica nos dois lados.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
